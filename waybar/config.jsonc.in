// Waybar for Pinnacle. A template: config/src/plugins/autostart.rs fills in @...@ from the
// settings, writes the result to $XDG_RUNTIME_DIR/pinnacle-config/waybar.jsonc and starts waybar
// with it. The style comes from the system default (/etc/xdg/waybar/style.css).
// Icons are Font Awesome 4.7 glyphs (private-use characters, invisible in many editors and tools).
// FA5-only codepoints render as boxes: the installed font is fonts-font-awesome 4.7.
{
    "height": 30,
    "spacing": 4,
    "modules-left": ["custom/tag-1", "custom/tag-2", "custom/tag-3", "custom/tag-4", "custom/tag-5", "custom/tag-6", "custom/tag-7", "custom/tag-8", "custom/tag-9"],
    "modules-center": ["clock"],
    "modules-right": ["pulseaudio", "network", "cpu", "memory", "temperature", "tray"],

    // Tags: one module per tag so each can be clicked. `pctl tags --watch --tag N` prints a new
    // line whenever tag N changes; the text is empty (module hidden) unless the tag is active,
    // shown as [N], or has windows. Click switches the focused output to it. Names match
    // tag_names in config/src/settings.rs. Waybar 0.9 cannot tell a module which output its bar
    // is on, so with several outputs a tag counts as active if it is active on any of them.
    "custom/tag-1": {
        "exec": "pctl tags --watch --tag 1",
        "return-type": "json",
        "restart-interval": 5,
        "on-click": "pctl tag 1"
    },
    "custom/tag-2": {
        "exec": "pctl tags --watch --tag 2",
        "return-type": "json",
        "restart-interval": 5,
        "on-click": "pctl tag 2"
    },
    "custom/tag-3": {
        "exec": "pctl tags --watch --tag 3",
        "return-type": "json",
        "restart-interval": 5,
        "on-click": "pctl tag 3"
    },
    "custom/tag-4": {
        "exec": "pctl tags --watch --tag 4",
        "return-type": "json",
        "restart-interval": 5,
        "on-click": "pctl tag 4"
    },
    "custom/tag-5": {
        "exec": "pctl tags --watch --tag 5",
        "return-type": "json",
        "restart-interval": 5,
        "on-click": "pctl tag 5"
    },
    "custom/tag-6": {
        "exec": "pctl tags --watch --tag 6",
        "return-type": "json",
        "restart-interval": 5,
        "on-click": "pctl tag 6"
    },
    "custom/tag-7": {
        "exec": "pctl tags --watch --tag 7",
        "return-type": "json",
        "restart-interval": 5,
        "on-click": "pctl tag 7"
    },
    "custom/tag-8": {
        "exec": "pctl tags --watch --tag 8",
        "return-type": "json",
        "restart-interval": 5,
        "on-click": "pctl tag 8"
    },
    "custom/tag-9": {
        "exec": "pctl tags --watch --tag 9",
        "return-type": "json",
        "restart-interval": 5,
        "on-click": "pctl tag 9"
    },
    "clock": {
        "format": "{:%a %d %b  %H:%M}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },
    "pulseaudio": {
        "format": "{volume}% {icon} {format_source}",
        "format-muted": " {format_source}",
        "format-source": "{volume}% ",
        "format-source-muted": "",
        "format-icons": {
            "headphone": "",
            "headset": "",
            "default": ["", "", ""]
        },
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },
    "network": {
        "format-wifi": "{essid} ({signalStrength}%) ",
        "format-ethernet": "{ipaddr}/{cidr} ",
        "format-linked": "{ifname} (No IP) ",
        "format-disconnected": "Disconnected ⚠",
        "tooltip-format": "{ifname} via {gwaddr}"
    },
    "cpu": {
        "format": "{usage}% ",
        "tooltip": false
    },
    "memory": {
        "format": "{}% "
    },
    "temperature": {
        // Filled in from settings.toml [waybar] temperature_hwmon (see autostart.rs).
        @TEMPERATURE_SOURCE@
        "critical-threshold": 80,
        "format": "{temperatureC}°C {icon}",
        "format-icons": ["", "", ""]
    },
    "tray": {
        "spacing": 10
    }
}
